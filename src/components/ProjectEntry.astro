---
import type { Project } from '../data/profile';
interface Props { project: Project }
const { project } = Astro.props;
const links = [
  { label: 'Repository', url: project.repository },
  { label: 'Original paper', url: project.paper },
  { label: 'Project page', url: project.page },
].filter(link => link.url);
---
<article class="project">
  {project.thumbnail && <img class="thumbnail" src={project.thumbnail.src} alt={project.thumbnail.alt} width="248" height="150" loading="lazy" />}
  <div>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    {project.details && <p>{project.details}</p>}
    {links.length > 0 ? <ul class="flex flex-wrap gap-x-5">{links.map(link => <li><a href={link.url}>{link.label} ↗</a></li>)}</ul> : <p class="note">Project links forthcoming</p>}
  </div>
</article>
