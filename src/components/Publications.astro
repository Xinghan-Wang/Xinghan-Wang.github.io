---
import type { Publication } from '../data/profile';
interface Props { items: Publication[] }
const { items } = Astro.props;
---
{items.length > 0 && <section aria-labelledby="publications">
  <h2 id="publications">Publications</h2>
  <ol>{items.map(item => <li class="my-4">
    <h3>{item.url ? <a href={item.url}>{item.title}</a> : item.title}</h3>
    <p>{item.authors}. <i>{item.venue}</i>, {item.year}.</p>
  </li>)}</ol>
</section>}
