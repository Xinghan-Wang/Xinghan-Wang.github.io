---
import { profile as p } from '../data/profile';
import ProjectEntry from '../components/ProjectEntry.astro';
import Publications from '../components/Publications.astro';
import '../styles/site.css';

const initials = p.name.split(/\s+/).map(word => word[0]).join('');
const title = p.name + ' | ' + p.university;
const date = new Date(p.updated + 'T00:00:00Z');
const updated = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={p.biography[0]} />
    <meta name="author" content={p.name} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={p.biography[0]} />
    {Astro.site && <link rel="canonical" href={Astro.site.href} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell mx-auto">
      <header class="mast flex items-center justify-between">
        <a href="#profile" class="brand flex items-center gap-4" aria-label={p.name + ', profile'}>
          <i>{initials}</i><span>Academic homepage</span>
        </a>
        <nav aria-label="Main navigation" class="flex items-center gap-5 sm:gap-8">
          <a href="#about">About</a><a href="#research">Research</a><a href="#projects">Projects</a>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <div class="hero" id="profile">
          <div>
            <h1>{p.name}</h1>
            <p class="role">{p.role}</p>
            <a class="university" href={p.universityUrl}>{p.university}</a>
            <div class="contacts flex flex-wrap items-center gap-x-6 gap-y-2">
              {p.email ? <a href={'mailto:' + p.email}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m3 6 9 7 9-7"/></svg>Email</a> : <span>Email pending</span>}
              {p.github ? <a href={p.github}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 20c-4 1-4-3-6-3m14 6v-4c0-1-.4-2-1-2.5 4-.5 6-2.5 6-6a5 5 0 0 0-1.4-3.5c.4-1 .4-2.4-.1-3.7-1.7 0-3 .8-4 1.4a13 13 0 0 0-7 0c-1-.6-2.6-1.5-4-1.4-.5 1.3-.5 2.7-.1 3.7A5 5 0 0 0 3 10.5c0 3.5 2 5.5 6 6-.6.6-1 1.5-1 2.5v4"/></svg>GitHub</a> : <span>GitHub pending</span>}
              {p.cv && <a href={p.cv}>Curriculum vitae ↗</a>}
            </div>
          </div>
          {p.photo ? <img class="portrait" src={p.photo} alt={p.name} width="160" height="176"/> :
            <div class="portrait placeholder" aria-label={'Profile photo placeholder for ' + p.name}>
              <i aria-hidden="true">{initials}</i><span>Photo placeholder</span>
            </div>}
        </div>
        <div class="overview">
          <section id="about"><h2>About Me</h2>{p.biography.map(paragraph => <p>{paragraph}</p>)}</section>
          <section id="research"><h2>Research Interests</h2><ul>{p.interests.map(item => <li>{item}</li>)}</ul></section>
        </div>
        <section id="projects"><h2>Projects</h2>{p.projects.map(project => <ProjectEntry project={project} />)}</section>
        <Publications items={p.publications}/>
      </main>
      <footer class="flex flex-wrap justify-between gap-3">
        <span>© {new Date().getUTCFullYear()} {p.name}</span>
        <span>Updated <time datetime={p.updated}>{updated}</time><span class="sep">·</span><a href="https://pages.github.com/">GitHub Pages</a></span>
      </footer>
    </div>
  </body>
</html>
